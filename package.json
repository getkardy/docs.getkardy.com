{
  "name": "@kardy/docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm build:progress && mint dev --port 3002 --no-open",
    "build:progress": "esbuild navigation-progress.ts --bundle --format=iife --target=es2020 --minify --outfile=navigation-progress.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs",
    "check:docs": "pnpm build:progress && mint validate && mint broken-links",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "precommit": "lint-staged --concurrent false && pnpm typecheck && pnpm test && pnpm check:docs"
  },
  "devDependencies": {
    "@bprogress/core": "1.3.4",
    "esbuild": "0.28.2",
    "mint": "4.2.875",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.57.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,json,md,mdx,css,yaml,yml}": "prettier --write --ignore-unknown",
    "*.{ts,tsx,js,jsx,mjs}": "eslint --fix"
  }
}
